# Порт API-сервера (в проде он же раздаёт собранный фронтенд)
PORT=8787
# Публичный адрес сайта (нужен для оплаты и web-push). Только HTTPS в проде!
PUBLIC_URL=https://radar.example.ru
# Секрет для шифрования ключей API/ЮKassa в базе. Сгенерируйте: openssl rand -hex 32
APP_SECRET=
# Папка с базой SQLite
DATA_DIR=./data
# Первый администратор (создаётся при старте, если его ещё нет)
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=
# 1 = разрешить тестовую активацию Радар+ без оплаты (по умолчанию включено только в dev)
DEMO_PAYMENTS=0
